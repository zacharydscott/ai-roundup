cabal-version:      3.0
name:               ai-roundup
version:            0.1.0.0
license:            BSD-3-Clause
author:             Zachary Scott
maintainer:         zacharydscott
category:           application
build-type:         Simple
synopsis:           Feed-watching agent that summarises what is new
extra-doc-files:    README.md

common warnings
    ghc-options: -Wall

-- One executable and no library, deliberately: there is no second consumer of
-- this code yet. Modules live under src/ rather than beside Main so that
-- growing a library later is a stanza plus a move of Main.hs, not a reshuffle
-- of every module.
executable ai-roundup
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   src
    other-modules:    AI.Roundup.Feed
                    , AI.Roundup.Store
                    , AI.Roundup.Summary
    build-depends:    base >=4.14 && <5
                    , bytestring
                    , conspire
                    , containers
                    , feed
                    , http-client
                    , http-client-tls
                    , http-types
                    , mtl
                    , optparse-applicative
                    , sqlite-simple
                    , text
                    , time
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
