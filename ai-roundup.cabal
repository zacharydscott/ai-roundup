cabal-version:      3.0
name:               ai-roundup
version:            0.1.0.0
license:            BSD-3-Clause
author:             Zachary Scott
maintainer:         zacharydscott
category:           application
build-type:         Simple
synopsis:           Feed-watching agent that summarises what is new
extra-doc-files:    README.md
-- schema.sql is read at compile time by Store.hs's file-embed splice, so a
-- source distribution without it does not build. sources.yaml is the default
-- the CLI looks for at run time.
extra-source-files: schema.sql
                    sources.yaml

common warnings
    ghc-options: -Wall

-- One executable and no library, deliberately: there is no second consumer of
-- this code yet. Modules live under src/ rather than beside Main so that
-- growing a library later is a stanza plus a move of Main.hs, not a reshuffle
-- of every module.
executable ai-roundup
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   src
    other-modules:    AI.Roundup.Apply
                    , AI.Roundup.ChangeSet
                    , AI.Roundup.Compose
                    , AI.Roundup.Config
                    , AI.Roundup.Group
                    , AI.Roundup.Ingest
                    , AI.Roundup.Ingest.Feed
                    , AI.Roundup.Ingest.Tavily
                    , AI.Roundup.Resolve
                    , AI.Roundup.Site
                    , AI.Roundup.Store
                    , AI.Roundup.Triage
    build-depends:    base >=4.20 && <5
                    , aeson
                    , async
                    , bytestring
                    , conspire
                    , containers
                    , directory
                    , feed
                    , file-embed
                    , filepath
                    , http-client
                    , http-client-tls
                    , http-types
                    , mtl
                    , optparse-applicative
                    , sqlite-simple
                    , text
                    , time
                    , yaml
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
